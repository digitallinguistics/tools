{
  "name": "@digitallinguistics/tools",
  "version": "0.1.0",
  "description": "Online tools for working with linguistic data",
  "private": true,
  "keywords": [
    "digital linguistics",
    "linguistics",
    "languages",
    "DLx",
    "digital humanities",
    "transliteration"
  ],
  "homepage": "https://tools.digitallinguistics.io",
  "bugs": "https://github.com/digitallinguistics/tools/issues",
  "license": "MIT",
  "author": {
    "name": "Daniel W. Hieber",
    "url": "https://github.com/dwhieb"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/digitallinguistics/tools.git"
  },
  "type": "module",
  "scripts": {
    "build": "eleventy",
    "open-cypress": "cypress open --config-file test/cypress.config.js",
    "postbuild": "node build/updateDocs.js",
    "run-cypress": "cypress run --config-file test/cypress.config.js",
    "start": "eleventy --serve",
    "test": "start-test http://localhost:3000 run-cypress"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@digitallinguistics/eslint-config": "^0.5.2",
    "@eslint/js": "^9.3.0",
    "@stylistic/eslint-plugin-js": "^2.1.0",
    "cypress": "^13.15.0",
    "eslint": "^9.3.0",
    "eslint-plugin-cypress": "^3.5.0",
    "fs-extra": "^11.2.0",
    "globals": "^15.10.0",
    "start-server-and-test": "^2.0.8",
    "yaml": "^2.5.1"
  }
}
